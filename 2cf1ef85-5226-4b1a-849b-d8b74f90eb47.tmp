const lblStyle = { fontSize: 11, color: 'var(--dim)', letterSpacing: '0.2em', marginBottom: 8 };

function WeekSegments({ total, week }) {
  return el('div', { style: { display: 'flex', gap: 3, marginTop: 10 } },
    Array.from({ length: total }, (_, i) => {
      const w = i + 1;
      const row = PROGRAM.weeks[i];
      const light = row.deload || row.test;
      return el('div', {
        key: w,
        style: {
          flex: 1,
          height: light ? 3 : 6,
          alignSelf: 'center',
          borderRadius: 2,
          background: w < week ? 'var(--accent)' : w === week ? 'var(--text)' : 'var(--border)',
          marginLeft: i > 0 && i % 4 === 0 ? 5 : 0
        }
      });
    }));
}

/* Top of TRAIN: where you are in the program, or the way into one. */
function ProgramBar({ program, activeDate, onStart, onOpenPlan }) {
  const status = progStatus(program);
  if (status === 'none') {
    return el('div', { className: 'card', style: { borderColor: 'var(--accent)', background: 'var(--accent-dim)', marginBottom: 14 } },
      el('div', { className: 'display', style: { fontSize: 11, color: 'var(--accent)', letterSpacing: '0.2em' } }, 'NO ACTIVE PROGRAM'),
      el('div', { className: 'display', style: { fontSize: 24, margin: '4px 0 6px', lineHeight: 1 } }, 'START FROM DAY 1'),
      el('div', { style: { fontSize: 12, color: 'var(--text)', lineHeight: 1.45, marginBottom: 12 } },
        'A 4, 8 or 12 week plan with sets, reps and effort set for every week. Existing logs are archived, not deleted.'),
      el('button', { className: 'btn-primary', onClick: onStart }, 'START A PROGRAM'));
  }
  const name = progName(program);
  const pos = progPos(program, activeDate);
  if (status === 'done' && !pos) {
    return el('div', { className: 'card', style: { borderColor: 'var(--accent)', background: 'var(--accent-dim)', marginBottom: 14 } },
      el('div', { className: 'display', style: { fontSize: 11, color: 'var(--accent)', letterSpacing: '0.2em' } }, name + ' COMPLETE'),
      el('div', { style: { fontSize: 12, color: 'var(--text)', lineHeight: 1.45, margin: '6px 0 12px' } },
        'Finished ' + fmtDate(progEnd(program)) + '. Check Week 1 against now in PLAN, then start the next one.'),
      el('div', { style: { display: 'flex', gap: 8 } },
        el('button', { className: 'btn-ghost', onClick: onOpenPlan, style: { flex: 1 } }, 'RESULTS'),
        el('button', { className: 'btn-primary', onClick: onStart, style: { flex: 2, padding: 12, fontSize: 14 } }, 'START NEXT PROGRAM')));
  }
  if (!pos) {
    const pause = progPause(program, activeDate);
    const msg = pause ? 'OFF WEEK · ' + name + ' resumes ' + fmtDate(addDays(pause.from, pause.days))
      : activeDate < program.start ? 'BEFORE DAY 1 · ' + name + ' starts ' + fmtDate(program.start)
      : 'AFTER ' + name + ' · ended ' + fmtDate(progEnd(program));
    return el('button', {
      onClick: onOpenPlan,
      style: { display: 'block', width: '100%', textAlign: 'left', padding: '10px 12px', marginBottom: 14, borderRadius: 10, border: '1px dashed var(--border)', background: 'var(--surface)' }
    }, el('span', { className: 'display', style: { fontSize: 11, color: 'var(--dim)', letterSpacing: '0.12em' } }, msg.toUpperCase()));
  }
  const w = pos.row;
  return el('button', {
    onClick: onOpenPlan,
    style: { display: 'block', width: '100%', textAlign: 'left', padding: '12px 14px', marginBottom: 14, borderRadius: 12, border: '1px solid var(--border)', background: 'var(--surface)' }
  },
    el('div', { style: { display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', gap: 8 } },
      el('span', { className: 'display', style: { fontSize: 11, color: 'var(--accent)', letterSpacing: '0.15em' } }, name + ' · BLOCK ' + pos.block.n + ' ' + pos.block.name),
      el('span', { className: 'mono', style: { fontSize: 11, color: 'var(--dim)' } }, 'DAY ' + pos.day + '/' + pos.totalDays)),
    el('div', { style: { display: 'flex', alignItems: 'baseline', gap: 8, marginTop: 4, flexWrap: 'wrap' } },
      el('span', { className: 'display', style: { fontSize: 22, lineHeight: 1 } }, 'WEEK ' + pos.week + ' OF ' + pos.weeksTotal),
      el('span', { className: 'display', style: { fontSize: 12, letterSpacing: '0.12em', color: w.deload || w.test ? 'var(--warn)' : 'var(--dim)' } }, w.tag)),
    el('div', { style: { fontSize: 12, color: 'var(--dim)', marginTop: 4 } },
      'Lifts at ', el('b', { style: { color: 'var(--text)' } }, 'RPE ' + w.rpe), ' — ' + rirText(w.rpe) + (w.deload ? ', about 10% lighter' : '')),
