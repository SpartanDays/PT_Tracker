/* CARDIO DAY CONTENT */
function CardioDayContent({
  type,
  pos,
  entry,
  onSave,
  onRemove
}) {
  const rx = cardioRx(pos, type.cardioType);
  const [mins, setMins] = useState(entry?.mins ?? (rx ? rx.mins : 30));
  const [secs, setSecs] = useState(entry?.secs ?? 0);
  const [dist, setDist] = useState(entry?.dist ?? '');
  const [unit, setUnit] = useState(entry?.unit ?? 'mi');
  const [rpe, setRpe] = useState(entry?.rpe ?? 6);
  const [notes, setNotes] = useState(entry?.notes ?? '');
  const [vert, setVert] = useState(entry?.vert ?? '');
  const [saved, setSaved] = useState(false);
  useEffect(() => {
    if (entry) {
      setMins(entry.mins ?? 30);
      setSecs(entry.secs ?? 0);
      setDist(entry.dist ?? '');
      setUnit(entry.unit ?? 'mi');
      setRpe(entry.rpe ?? 6);
      setNotes(entry.notes ?? '');
      setVert(entry.vert ?? '');
