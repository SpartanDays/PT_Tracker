<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Iron Log">
<meta name="theme-color" content="#0a0a0c">

<title>Iron Log</title>
<link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<meta name="apple-mobile-web-app-title" content="Iron Log">
<link rel="manifest" href='data:application/manifest+json,{"name":"Iron Log","short_name":"Iron Log","display":"standalone","background_color":"%230a0a0c","theme_color":"%230a0a0c"}'>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0a0a0c; --surface: #15151a; --elev: #1f1f26; --border: #2a2a32;
  --text: #f5f5f7; --dim: #8a8a96; --faint: #4a4a52;
  --accent: #d4ff3a; --accent-dim: #3a4a14;
  --danger: #ff4444; --good: #3aff7a; --warn: #ffaa3a;
}
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none; }
html, body { margin: 0; padding: 0; background: var(--bg); }
body { font-family: 'Archivo', sans-serif; color: var(--text); overscroll-behavior: none; min-height: 100vh; }
#app { padding-bottom: 88px; padding-top: env(safe-area-inset-top); }
.display { font-family: 'Anton', sans-serif; letter-spacing: 0.02em; }
.mono { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; }
button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; padding: 0; }
input, textarea { font-family: inherit; }
input[type=number] { -moz-appearance: textfield; }
input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.container { max-width: 480px; margin: 0 auto; position: relative; }
.noise { position: fixed; inset: 0; pointer-events: none; opacity: 0.025; z-index: 1; mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence baseFrequency='0.9'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }
@keyframes slidein { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.slidein { animation: slidein 0.22s ease-out; }
@keyframes flash { 0% { background: var(--accent); } 100% { background: transparent; } }
.flash { animation: flash 0.5s ease-out; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
.pulse { animation: pulse 1s ease-in-out infinite; }

/* Bottom nav */
.bottomnav { position: fixed; bottom: 0; left: 0; right: 0; background: rgba(10,10,12,0.92); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-top: 1px solid var(--border); z-index: 50; padding-bottom: env(safe-area-inset-bottom); }
.bottomnav-inner { max-width: 480px; margin: 0 auto; display: grid; grid-template-columns: repeat(5, 1fr); }
.navbtn { padding: 12px 0 14px; display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--dim); transition: color 0.15s; }
.navbtn.active { color: var(--accent); }
.navbtn .label { font-family: 'Anton', sans-serif; font-size: 10px; letter-spacing: 0.12em; }
.navbtn svg { width: 22px; height: 22px; }

/* Cards */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px; margin-bottom: 10px; }
.btn-primary { width: 100%; padding: 16px; background: var(--accent); color: var(--bg); border-radius: 12px; font-family: 'Anton', sans-serif; font-size: 16px; letter-spacing: 0.06em; font-weight: 800; }
.btn-primary:disabled { opacity: 0.4; }
.btn-ghost { padding: 10px 14px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 14px; }
.chip { padding: 4px 10px; border-radius: 6px; background: var(--elev); font-size: 13px; }

/* Header */
.h1 { font-family: 'Anton', sans-serif; font-size: 52px; line-height: 0.95; margin: 4px 0 0; }
.eyebrow { font-family: 'Anton', sans-serif; font-size: 12px; color: var(--dim); letter-spacing: 0.2em; }

/* Selector */
.tier-row { display: flex; gap: 6px; }
.tier-btn { flex: 1; padding: 10px 0; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--dim); font-family: 'Anton', sans-serif; font-size: 13px; letter-spacing: 0.15em; transition: all 0.15s; }
.tier-btn.active { background: var(--accent); color: var(--bg); border-color: var(--accent); font-weight: 800; }

/* Number row */
.num-row { display: flex; align-items: center; gap: 8px; background: var(--surface); padding: 8px; border-radius: 12px; border: 1px solid var(--border); }
.num-row input { flex: 1; min-width: 0; text-align: center; background: transparent; border: none; color: var(--text); font-family: 'Anton', sans-serif; font-size: 44px; padding: 6px; outline: none; }
.num-btn { padding: 6px 10px; min-width: 44px; background: var(--elev); border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--text); }
.num-stack { display: flex; flex-direction: column; gap: 4px; }

/* Tabs sub */
.subtabs { display: flex; gap: 4px; padding: 4px; background: var(--surface); border-radius: 10px; border: 1px solid var(--border); margin: 0 0 12px; }
.subtab { flex: 1; padding: 10px 0; border-radius: 7px; color: var(--dim); font-family: 'Anton', sans-serif; font-size: 12px; letter-spacing: 0.15em; transition: all 0.15s; text-align: center; }
.subtab.active { background: var(--accent); color: var(--bg); font-weight: 800; }

/* Timer specific */
.timer-display { text-align: center; padding: 28px 0; }
.timer-num { font-family: 'Anton', sans-serif; font-size: 96px; line-height: 1; font-variant-numeric: tabular-nums; color: var(--text); }
.timer-num.warn { color: var(--warn); }
.timer-num.danger { color: var(--danger); }
.timer-label { font-family: 'Anton', sans-serif; letter-spacing: 0.2em; color: var(--dim); font-size: 12px; margin-bottom: 8px; }
.preset-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 12px; }
.preset-btn { padding: 14px 0; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; font-family: 'Anton', sans-serif; font-size: 16px; color: var(--text); letter-spacing: 0.05em; }
.preset-btn.active { background: var(--accent-dim); border-color: var(--accent); color: var(--accent); }
.big-btn { padding: 22px 0; font-size: 22px; }
.progress-ring { transform: rotate(-90deg); }

/* Exercise card */
.ex-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; margin-bottom: 8px; }
.ex-card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.ex-name { font-family: 'Anton', sans-serif; font-size: 16px; letter-spacing: 0.04em; flex: 1; }
.ex-meta { font-size: 12px; color: var(--dim); margin-top: 4px; }
.ex-cues { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border); }
.ex-cue { font-size: 13px; color: var(--text); padding: 4px 0 4px 14px; position: relative; line-height: 1.4; }
.ex-cue::before { content: "▸"; color: var(--accent); position: absolute; left: 0; top: 4px; }
.yt-btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: var(--accent-dim); color: var(--accent); border-radius: 6px; font-size: 12px; font-family: 'Anton', sans-serif; letter-spacing: 0.1em; text-decoration: none; }

.scrollarea::-webkit-scrollbar { width: 6px; }
.scrollarea::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
</style>
</head>
<body>
<div id="app"><div style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:#0a0a0c;color:#d4ff3a;font-family:-apple-system,sans-serif;"><div style="font-size:30px;font-weight:900;letter-spacing:0.1em;">IRON LOG</div><div style="font-size:12px;color:#777;">loading…</div></div><div class="container" style="padding:24px;text-align:center;color:var(--dim);font-family:'Anton',sans-serif;">LOADING…</div></div>
<div class="noise"></div>

<script>
