  },
  'Box Step-Up': {
    cat: 'Squat / Knee-Dominant',
    cues: ['20–24 inch box, whole foot on', 'Drive through the top heel — no bottom-leg push-off', 'Load with pack or DBs as hunt season nears'],
    pf: 'Use a bench'
  },
  'Push Press': {
    cat: 'Vertical Press',
    cues: ['Dip 2–3 inches, knees out', 'Drive legs hard, bar pops off shoulders', 'Finish locked out, ribs down'],
