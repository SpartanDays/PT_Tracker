/* =========================================================
   SCHEDULE HELPERS
   ========================================================= */
function getMondayOfWeek(d) {
  d = new Date(d);
  d.setHours(12, 0, 0, 0);
  const day = d.getDay() || 7; // Sun = 0 → 7
  const mon = new Date(d);
  mon.setDate(d.getDate() - (day - 1));
  return mon;
}
function getWeekDates(d) {
  const mon = getMondayOfWeek(d || new Date());
  return Array.from({
    length: 7
  }, (_, i) => {
    const dt = new Date(mon);
    dt.setDate(mon.getDate() + i);
    return dkey(dt);
  });
}
function ensureDefaultWeek(schedule, dates, program) {
  const next = {
    ...schedule
  };
  let changed = false;
  dates.forEach(d => {
    if (!next[d]) {
      next[d] = {
        type: defaultType(program, d),
        note: ''
      };
      changed = true;
    }
  });
  return changed ? next : schedule;
}

// Cascade swap: change a day's workout, push the displaced workout to the next available day
function cascadeSwap(schedule, dateKey, newType, doCascade, program) {
  const next = {
    ...schedule
  };
  const dates = getWeekDates(new Date(dateKey + 'T12:00:00'));
  const idx = dates.indexOf(dateKey);
  if (idx === -1) {
    next[dateKey] = {
      ...(next[dateKey] || {}),
      type: newType
    };
    return next;
  }
  const oldType = next[dateKey]?.type || defaultType(program, dateKey);
  next[dateKey] = {
    ...(next[dateKey] || {}),
    type: newType
  };
  if (!doCascade || !oldType || oldType === newType || oldType === 'rest') return next;

  // Cascade forward: push displaced into first rest, bumping any non-rest days along the way
  let displaced = oldType;
  for (let i = idx + 1; i < dates.length; i++) {
    const k = dates[i];
    const cur = next[k] && next[k].type || defaultType(program, k);
    if (cur === 'rest') {
      next[k] = {
        ...(next[k] || {}),
        type: displaced
