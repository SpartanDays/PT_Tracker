// Storage layer. Prefers Claude's artifact persistent storage (window.storage),
// which survives across sessions; falls back to localStorage for true standalone/
// offline use. NOTE: localStorage does NOT work inside Claude artifacts, which is
// why everything must route through this abstraction.
const STORE = (() => {
  let mode = 'memory';
  let cs = null;
  let lsOk = false;
  const mem = {};

  const probeLS = () => {
    try {
      const t = '__il_probe__';
      localStorage.setItem(t, '1');
      const v = localStorage.getItem(t);
      localStorage.removeItem(t);
      return v === '1';
    } catch (e) {
      return false;
    }
  };

  return {
    get mode() { return mode; },
    // Determine which backend ACTUALLY works via a real round-trip, before any saves run.
    async init() {
      const cand = (typeof window !== 'undefined' && window.storage
        && typeof window.storage.set === 'function'
        && typeof window.storage.get === 'function') ? window.storage : null;
      if (cand) {
        try {
          await cand.set('__il_probe__', '1');
          let ok = false;
          try {
            const r = await cand.get('__il_probe__');
            ok = !!(r && r.value != null);
          } catch (e) { ok = false; }
          if (ok) {
            cs = cand;
            mode = 'cloud';
            try { await cand.delete('__il_probe__'); } catch (e) {}
            return;
          }
        } catch (e) {
          // window.storage exists but is non-functional in this context — fall back.
        }
      }
      lsOk = probeLS();
      mode = lsOk ? 'local' : 'memory';
    },
    async get(k, fb) {
      try {
        if (mode === 'cloud' && cs) {
          const r = await cs.get(k);
          return (r && r.value != null) ? JSON.parse(r.value) : fb;
        }
        if (mode === 'local') {
          const v = localStorage.getItem(k);
          return v != null ? JSON.parse(v) : fb;
        }
        return (k in mem) ? mem[k] : fb;
      } catch (e) {
        return fb;
      }
    },
    set(k, v) {
      let s;
      try { s = JSON.stringify(v); } catch (e) { return; }
      mem[k] = v; // always keep an in-memory copy for the live session
      try {
        if (mode === 'cloud' && cs) {
          // Fire-and-forget, but swallow any rejection so it never blanks the app.
          Promise.resolve(cs.set(k, s)).catch(() => {});
          return;
        }
        if (mode === 'local') {
          localStorage.setItem(k, s);
        }
      } catch (e) {}
    }
  };
})();

const save = (k, v) => STORE.set(k, v);
const loadAsync = (k, fb) => STORE.get(k, fb);
// Sync loader kept only for any legacy call sites (localStorage path).
const load = (k, fb) => {
  try {
    const v = localStorage.getItem(k);
    return v != null ? JSON.parse(v) : fb;
  } catch {
    return fb;
  }
};

/* =========================================================
   HELPERS
   ========================================================= */
// Date keys are LOCAL calendar dates. They used to come from toISOString(), which is UTC:
// after ~8pm Eastern "today" silently became tomorrow and evening sessions landed on the wrong day.
const dkey = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
const todayKey = () => dkey(new Date());
const keyToDate = k => new Date(k + 'T12:00:00');
const addDays = (k, n) => {
  const d = keyToDate(k);
  d.setDate(d.getDate() + n);
  return dkey(d);
};
const dayDiff = (a, b) => Math.round((keyToDate(b) - keyToDate(a)) / 86400000); // b minus a, in days
const fmtDate = k => new Date(k + 'T12:00:00').toLocaleDateString(undefined, {
  weekday: 'short',
  month: 'short',
  day: 'numeric'
});
const fmtShort = k => keyToDate(k).toLocaleDateString(undefined, {
  month: 'short',
  day: 'numeric'
});
const daysAgo = k => dayDiff(k, todayKey());
const fmtMMSS = s => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
function warmupRamp(weight, isBw) {
  if (isBw || !weight || weight < 65) return [];
  const round = w => Math.max(45, Math.round(w / 5) * 5);
  return [{
    label: 'Bar',
    w: 45,
    r: 8
  }, {
    label: '50%',
    w: round(weight * 0.5),
    r: 5
  }, {
    label: '70%',
    w: round(weight * 0.7),
    r: 3
  }, {
    label: '85%',
    w: round(weight * 0.85),
    r: 1
  }];
}

// Audio + vibration
let audioCtx = null;
function ensureAudio() {
  if (!audioCtx) {
    try {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    } catch {}
  }
  if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
  return audioCtx;
}
function beep(freq = 880, dur = 200, gain = 0.4) {
  const ctx = ensureAudio();
  if (!ctx) return;
  const osc = ctx.createOscillator();
  const g = ctx.createGain();
  osc.connect(g);
  g.connect(ctx.destination);
  osc.frequency.value = freq;
  osc.type = 'sine';
  g.gain.setValueAtTime(gain, ctx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur / 1000);
  osc.start();
  osc.stop(ctx.currentTime + dur / 1000);
}
function buzz(pattern) {
  if (navigator.vibrate) try {
    navigator.vibrate(pattern);
  } catch {}
}
function alertEnd() {
  beep(880, 180);
  setTimeout(() => beep(1100, 220), 220);
  setTimeout(() => beep(1320, 280), 480);
  buzz([200, 100, 200, 100, 400]);
}
function alertHalfway() {
  beep(660, 100);
  buzz([80]);
}

