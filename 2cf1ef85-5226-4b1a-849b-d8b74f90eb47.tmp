    cues: ['Same 30-45° angle', 'Press slightly inward at top for chest squeeze', 'Control bottom — DBs further apart at the bottom'],
    pf: 'Standard at PF'
  },
  'Smith Bench': {
    cat: 'Horizontal Press',
    cues: ['Set bench so bar lowers to lower chest', 'Same scap retraction, arch, leg drive', 'Bar path is fixed — engage like free bench'],
    pf: 'Default PF bench'
  },
  'Pushup': {
    cat: 'Horizontal Press',
    cues: ['Straight line head to heels — no sag, no pike', 'Elbows ~45° from torso, not flared', 'Full ROM — chest to floor'],
    pf: 'Bodyweight anywhere'
  },
  'Sandbag Pushup': {
    cat: 'Horizontal Press',
    cues: ['Sandbag on upper back, balanced', 'Same form as pushup — straight line, controlled', 'Brace harder to manage the load'],
    pf: 'Use weighted vest at PF or skip'
  },
  // VERTICAL PRESS
  'Overhead Press': {
    cat: 'Vertical Press',
    cues: ['Tight grip, bar on the shelf of your palm', 'Glutes squeezed, ribs down — don\'t arch low back', 'Press bar back over crown of head, finish with biceps near ears'],
    pf: 'Smith OHP or DB shoulder press'
  },
  'DB Shoulder Press': {
    cat: 'Vertical Press',
    cues: ['Seated or standing — both fine', 'Wrists stacked over elbows', 'Don\'t press behind head — bad shoulder position'],
    pf: 'Standard at PF'
  },
  'Smith OHP': {
    cat: 'Vertical Press',
    cues: ['Less stabilization needed — focus on press', 'Same form: tight glutes, ribs down, full lockout', 'Sit on bench with back support if shoulders cranky'],
    pf: 'Default PF overhead option'
  },
  // HORIZONTAL PULL
  'Barbell Row': {
    cat: 'Horizontal Pull',
