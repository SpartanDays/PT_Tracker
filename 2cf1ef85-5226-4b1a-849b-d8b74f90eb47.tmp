const SCHED = {
  lowerS: { label: 'Lower — Strength', short: 'LOWER', kind: 'lift', workoutKey: 'lowerS', color: 'var(--accent)' },
  upperS: { label: 'Upper — Strength', short: 'UPPER', kind: 'lift', workoutKey: 'upperS', color: 'var(--accent)' },
  fullBody: { label: 'Full Body — Athletic', short: 'FULL', kind: 'lift', workoutKey: 'fullBody', color: 'var(--accent)' },
  run: { label: 'Z2 Run', short: 'RUN', kind: 'cardio', cardioType: 'run', color: 'var(--warn)' },
  trail: { label: 'Trail Run', short: 'TRAIL', kind: 'cardio', cardioType: 'trail', color: 'var(--warn)' },
  ruck: { label: 'Ruck', short: 'RUCK', kind: 'cardio', cardioType: 'ruck', color: 'var(--warn)' },
  hiit: { label: 'HIIT — Hard Conditioning', short: 'HIIT', kind: 'cardio', cardioType: 'hiit', color: 'var(--warn)' },
  bjj: { label: 'Jiu Jitsu', short: 'BJJ', kind: 'cardio', cardioType: 'bjj', color: 'var(--warn)' },
  bag: { label: 'Heavy Bag', short: 'BAG', kind: 'cardio', cardioType: 'bag', color: 'var(--warn)' },
  bike: { label: 'Peloton', short: 'BIKE', kind: 'cardio', cardioType: 'bike', color: 'var(--warn)' },
  row: { label: 'Row Erg', short: 'ROW', kind: 'cardio', cardioType: 'row', color: 'var(--warn)' },
  custom: { label: 'Custom', short: 'CUSTOM', kind: 'custom', color: 'var(--dim)' },
  rest: { label: 'Rest Day', short: 'REST', kind: 'rest', color: 'var(--faint)' }
};
// Legacy day types from the old 4-day split map onto the new program
const LEGACY_TYPES = { lowerA: 'lowerS', upperA: 'upperS', lowerB: 'fullBody', upperB: 'upperS', condArms: 'hiit' };
const SCHED_ORDER_LIFT = ['lowerS', 'upperS', 'fullBody'];
const SCHED_ORDER_CARDIO = ['run', 'trail', 'ruck', 'hiit', 'bjj', 'bag', 'bike', 'row'];
const SCHED_ORDER_OTHER = ['custom', 'rest'];

// Default Mon–Sun: 3 lifts + Z2 + 1 hard conditioning + long effort + rest
const DEFAULT_WEEK = ['lowerS', 'upperS', 'run', 'hiit', 'fullBody', 'trail', 'rest'];
const DOW_LABELS = ['MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN'];

/* =========================================================
   PROGRAM — a 4, 8 or 12 week plan built from 4-week blocks
   (3 loading weeks + 1 deload). Day 1 is whatever date you pick.
   ========================================================= */
const APP_VERSION = 'v3.1 · 2026-11-19';
const PROGRAM = {
  id: 'reset',
  // Day 1..7 of every program week. 'long' alternates ruck (odd weeks) / trail (even weeks).
  days: ['lowerS', 'upperS', 'run', 'hiit', 'fullBody', 'long', 'rest'],
  blocks: [{
    n: 1, name: 'BASE', weeks: [1, 4],
    goal: 'Re-entry. Submaximal loads and moderate reps rebuild work capacity, tendons and technique before intensity goes up.',
    reps: 'Main lifts 8–10 reps · accessories 10–12'
  }, {
    n: 2, name: 'BUILD', weeks: [5, 8],
    goal: 'Heavier loads, more sets. Most of the muscle and strength in this program gets built here.',
    reps: 'Main lifts 6–8 reps · accessories 8–12'
  }, {
    n: 3, name: 'PEAK', weeks: [9, 12],
    goal: 'Heaviest loads, lowest reps. The last week retests against Week 1.',
    reps: 'Main lifts 4–6 reps · accessories 8–10'
  }],
  // One row per week. rpe = lift effort target. main / acc = working sets at TARGET tier.
  weeks: [{
    tag: 'INTRO', rpe: 6, main: 2, acc: 2, z2: 30,
    hard: { mins: 28, text: 'Bike or row: 5 min easy, then 6 × 1 min hard (RPE 8) / 2 min easy, 5 min easy.' },
    long: { type: 'ruck', mins: 45, text: 'Ruck 45 min @ 35 lb on flat-to-rolling ground.' },
    note: 'Calibration week. End every set with about 4 reps left. If a set feels easier than RPE 6, add 5–10 lb on the next one. You should leave feeling you could repeat the session.'
  }, {
    tag: 'LOAD', rpe: 7, main: 3, acc: 2, z2: 30,
    hard: { mins: 34, text: 'Bike or row: 5 min easy, then 8 × 1 min hard (RPE 8) / 2 min easy, 5 min easy.' },
    long: { type: 'trail', mins: 50, text: 'Trail 50 min at Z2. Run the flats, hike the climbs.' },
    note: 'Main lifts go to 3 sets. 3 reps in the tank on every set.'
  }, {
    tag: 'PUSH', rpe: 7.5, main: 3, acc: 3, z2: 35,
    hard: { mins: 35, text: 'Bike or row: 5 min easy, then 10 × 1 min hard (RPE 8–9) / 90 s easy, 5 min easy.' },
    long: { type: 'ruck', mins: 60, text: 'Ruck 60 min @ 35–40 lb. Add hills.' },
    note: 'Hardest week of the block. 2–3 reps in the tank — still no grinders.'
  }, {
    tag: 'DELOAD', rpe: 6, main: 2, acc: 2, z2: 25, deload: true,
    hard: { mins: 25, text: 'Bike or row: 5 × 1 min hard / 2 min easy. Stay sharp, not tired.' },
    long: { type: 'trail', mins: 40, text: 'Trail or hike 40 min, easy.' },
    note: 'Deload. About 10% lighter, fewer sets, nothing hard. This is the week the first three turn into fitness — do not skip it and do not add to it.'
  }, {
    tag: 'LOAD', rpe: 7, main: 3, acc: 2, z2: 35,
    hard: { mins: 25, text: 'Hill sprints: 6 × 30 s uphill, walk down to recover. Or heavy bag 4 × 3 min / 1 min rest.' },
    long: { type: 'ruck', mins: 70, text: 'Ruck 70 min @ 40 lb.' },
    note: 'New block: reps drop to 6–8 and the bar gets heavier. Start at 3 reps in the tank.'
  }, {
    tag: 'LOAD', rpe: 8, main: 3, acc: 3, z2: 40,
    hard: { mins: 28, text: 'Hill sprints: 8 × 30 s uphill, walk down. Or heavy bag 5 × 3 min / 1 min rest.' },
    long: { type: 'trail', mins: 65, text: 'Trail 65 min at Z2.' },
    note: '2 reps in the tank on main lifts. Accessories get a third set.'
  }, {
    tag: 'PUSH', rpe: 8.5, main: 4, acc: 3, z2: 40,
    hard: { mins: 30, text: 'Hill sprints: 10 × 30 s uphill, walk down. Or heavy bag 6 × 3 min / 1 min rest.' },
    long: { type: 'ruck', mins: 80, text: 'Ruck 80 min @ 40–45 lb with hills.' },
    note: 'Highest volume of the program: 4 sets on main lifts. Sleep and protein decide whether this week works.'
  }, {
    tag: 'DELOAD', rpe: 6, main: 2, acc: 2, z2: 30, deload: true,
    hard: { mins: 20, text: 'Hill sprints 5 × 30 s or heavy bag 3 × 3 min. Leave plenty in reserve.' },
    long: { type: 'trail', mins: 45, text: 'Trail or hike 45 min, easy.' },
    note: 'Deload. About 10% lighter, fewer sets, nothing hard.'
  }, {
    tag: 'LOAD', rpe: 7.5, main: 3, acc: 2, z2: 40,
    hard: { mins: 38, text: '4 × 4 min @ RPE 8 / 3 min easy — bike, row or a steady uphill. 5 min easy either side.' },
    long: { type: 'ruck', mins: 90, text: 'Ruck 90 min @ 45 lb.' },
    note: 'Heaviest phase: 4–6 reps on main lifts. Open conservative — 2–3 reps in the tank.'
  }, {
    tag: 'LOAD', rpe: 8.5, main: 4, acc: 3, z2: 45,
    hard: { mins: 45, text: '5 × 4 min @ RPE 8 / 3 min easy — bike, row or uphill.' },
    long: { type: 'trail', mins: 75, text: 'Trail 75 min at Z2.' },
    note: '4 sets, 1–2 reps in the tank. Every rep still moves fast — no grinding.'
  }, {
    tag: 'PUSH', rpe: 9, main: 4, acc: 3, z2: 45,
    hard: { mins: 45, text: '5 × 4 min @ RPE 8–9 / 3 min easy — bike, row or uphill.' },
    long: { type: 'ruck', mins: 100, text: 'Ruck 100 min @ 45 lb. Find the most vert you can.' },
    note: 'Top of the program. 1 rep in the tank on squat, bench and presses. Deadlift and RDL stay capped at RPE 8.'
  }, {
    tag: 'TEST', rpe: 9, accRpe: 7, main: 2, acc: 2, z2: 30, test: true,
    hard: { mins: 30, text: '3 × 4 min @ RPE 8 / 3 min easy. Skip it if you are beat up.' },
    long: { type: 'trail', mins: 50, text: 'Easy hike 45–60 min. Program done.' },
    note: 'Test + deload. One top set per main lift at RPE 9, one back-off set, accessories easy at RPE 7, then go home. Compare against Week 1 in PLAN → PROGRAM.'
  }]
};
const ROLE_REPS = {
  main: ['8–10', '6–8', '4–6'],
  acc: ['10–12', '8–12', '8–10']
};
const progName = p => 'RESET ' + (p && p.weeks || 12);
const rirText = rpe => {
  const r = 10 - rpe;
  return (Number.isInteger(r) ? r : Math.floor(r) + '–' + Math.ceil(r)) + (r === 1 ? ' rep' : ' reps') + ' in the tank';
};
const weekdayIdx = k => (keyToDate(k).getDay() + 6) % 7; // Mon = 0

// Off weeks (sick, travel, hunt) are stored as pauses: { from: 'YYYY-MM-DD', days: 7 }.
// A paused date has no program position; every date after it shifts back by the pause.
function progPause(program, dateKey) {
  if (!program || !program.pauses) return null;
  return program.pauses.find(p => {
    const off = dayDiff(p.from, dateKey);
    return off >= 0 && off < p.days;
  }) || null;
}
function progPos(program, dateKey) {
  if (!program || !program.start) return null;
  let idx = dayDiff(program.start, dateKey);
  if (idx < 0) return null;
  const pauses = program.pauses || [];
  for (let i = 0; i < pauses.length; i++) {
    const off = dayDiff(pauses[i].from, dateKey);
    if (off >= 0 && off < pauses[i].days) return null;
    if (off >= pauses[i].days) idx -= pauses[i].days;
  }
  const weeksTotal = program.weeks || 12;
  if (idx >= weeksTotal * 7) return null;
  const week = Math.floor(idx / 7) + 1;
  return {
    idx,
    day: idx + 1,
    totalDays: weeksTotal * 7,
    week,
    weeksTotal,
    dow: idx % 7,
    row: PROGRAM.weeks[week - 1],
    block: PROGRAM.blocks.find(b => week >= b.weeks[0] && week <= b.weeks[1])
  };
}
function progEnd(program) {
  const pauseDays = (program.pauses || []).reduce((s, p) => s + p.days, 0);
  return addDays(program.start, (program.weeks || 12) * 7 - 1 + pauseDays);
}
// 'none' | 'upcoming' | 'active' | 'done'
function progStatus(program) {
  if (!program || !program.start) return 'none';
  const t = todayKey();
  if (t < program.start) return 'upcoming';
  if (t > progEnd(program)) return 'done';
  return 'active';
}
// Calendar rows for the plan view: program weeks with their real dates, plus any off weeks.
function progCalendar(program) {
  const rows = [];
  const pauses = (program.pauses || []).slice().sort((a, b) => a.from.localeCompare(b.from));
  let d = program.start;
  for (let w = 1; w <= (program.weeks || 12); w++) {
    let p;
    while (p = pauses.find(x => x.from === d)) {
      rows.push({ off: true, from: d, to: addDays(d, p.days - 1), pause: p });
      d = addDays(d, p.days);
    }
    rows.push({ week: w, from: d, to: addDays(d, 6), row: PROGRAM.weeks[w - 1], block: PROGRAM.blocks.find(b => w >= b.weeks[0] && w <= b.weeks[1]) });
    d = addDays(d, 7);
  }
  return rows;
}
function progDayType(pos) {
  const t = PROGRAM.days[pos.dow];
  return t === 'long' ? pos.row.long.type : t;
}
// What a date should be before the user has touched it.
function defaultType(program, dateKey) {
  const pos = progPos(program, dateKey);
  if (pos) return progDayType(pos);
  if (progPause(program, dateKey)) return 'rest';
  return DEFAULT_WEEK[weekdayIdx(dateKey)];
}

// Resolve one planned item for a program week + tier. Outside a program the static text stands.
function parseReps(s) {
  const m = String(s).match(/(\d+)(?:\D+(\d+))?/);
  if (!m) return { lo: 8, hi: 8 };
  return { lo: +m[1], hi: +(m[2] || m[1]) };
}
function resolveItem(item, pos, tier) {
  if (!pos || !item.role) return item;
  const wk = pos.row;
  if (item.role === 'pre') {
    const light = wk.deload || wk.test;
    return light ? { ...item, text: item.text.replace(/^(\d+)×/, (m, n) => Math.max(1, n - 1) + '×') } : item;
  }
  let sets = item.role === 'main' ? wk.main : wk.acc;
  if (item.maxSets) sets = Math.min(sets, item.maxSets);
  if (tier === 'min') sets = Math.max(2, sets - 1);
  const repsTxt = (item.reps || ROLE_REPS[item.role])[pos.block.n - 1];
  const { lo, hi } = parseReps(repsTxt);
  const rpe = Math.min(item.role === 'acc' && wk.accRpe ? wk.accRpe : wk.rpe, item.rpeCap || 10);
  const per = item.per || '';
  let text = sets + '×' + repsTxt + per + ' @RPE ' + rpe;
  if (wk.test && item.role === 'main') {
    sets = 2;
    text = 'TEST · 1×' + repsTxt + ' @RPE ' + rpe + ', then 1×' + repsTxt + ' at −10%';
  }
  return { ...item, text, rx: { sets, lo, hi, rpe, repsTxt: repsTxt + per } };
}
function tierItems(def, tier) {
  if (tier === 'min') return def.tiers.min;
  if (tier === 'max') return [...def.tiers.target, ...(def.tiers.maxAdds || []).map(x => ({ ...x, isMaxAdd: true }))];
  return def.tiers.target;
}
const resolvedTierList = (def, tier, pos) => tierItems(def, tier).map(it => resolveItem(it, pos, tier));
// The prescription for one exercise on one date (null if it is not part of that day's plan).
function rxForExercise(program, schedule, dateKey, tier, name) {
  const pos = progPos(program, dateKey);
  if (!pos) return null;
  const sc = SCHED[schedule[dateKey] && schedule[dateKey].type || defaultType(program, dateKey)];
  if (!sc || sc.kind !== 'lift') return null;
  const def = WORKOUTS.find(w => w.key === sc.workoutKey);
  if (!def) return null;
  const match = it => it.ex === name || it.alt === name;
  const item = (tier === 'min' ? resolvedTierList(def, 'min', pos).find(match) : null) || resolvedTierList(def, 'max', pos).find(match);
  return item ? { ...item, pos } : null;
}

// Estimated 1-rep max from a logged set. RPE turns into reps-in-reserve so an easy
// Week 1 set and a hard Week 11 set land on the same scale.
const e1rm = (w, r, rpe) => w * (1 + (r + (rpe ? Math.max(0, 10 - rpe) : 0)) / 30);
const bestE1rm = (session, fallbackRpe) => {
  const sets = (session && session.sets || []).filter(s => s.w > 0 && s.r > 0);
  if (!sets.length) return 0;
  return Math.max(...sets.map(s => e1rm(s.w, s.r, s.rpe || fallbackRpe)));
};
// Reference for the next load: the best estimated max from the last two sessions that were
// not deloads. A deload set is light on purpose and would drag the estimate down; one bad day
// should not either. `sessions` is newest-first.
function loadRef(program, sessions, rpeCap) {
  if (!sessions || !sessions.length) return null;
  const tgt = x => {
    const p = progPos(program, x.date);
    return p ? Math.min(p.row.rpe, rpeCap || 10) : 0;
  };
  const loaded = sessions.filter(x => {
    const p = progPos(program, x.date);
    return !(p && p.row.deload);
  });
  const pool = (loaded.length ? loaded : sessions).slice(0, 2);
  const last = pool[0];
  const lastTarget = tgt(last);
  return {
    last,
    est: Math.max(...pool.map(x => bestE1rm(x, tgt(x)))),
    top: Math.max(...last.sets.map(x => x.w || 0)),
    // Stayed at or under the effort target last time (unlogged RPE counts as on target)
    onTarget: !lastTarget || Math.max(...last.sets.map(x => x.rpe || 0)) <= lastTarget + 0.5
  };
}
// Next load. Loading weeks: the estimated max re-expressed at today's reps and RPE, plus 2%
// if the last session stayed on target. Never more than +10% over last time's heaviest set.
// Deload weeks: 90% of last time's heaviest set. Test week: no bump — an honest read.
function suggestLoad(ref, rx, wk) {
  if (!ref || !ref.est || !rx) return null;
  const round5 = w => Math.max(5, Math.round(w / 5) * 5);
  if (wk && wk.deload) return round5(ref.top * 0.9);
  const mid = (rx.lo + rx.hi) / 2;
  const bump = wk && !wk.test && ref.onTarget ? 1.02 : 1;
  const w = ref.est / (1 + (mid + (10 - rx.rpe)) / 30) * bump;
  return round5(Math.min(w, ref.top * 1.1));
}
// Cardio prescription for a program week, by session type.
function cardioRx(pos, cardioType) {
  if (!pos) return null;
  const w = pos.row;
  const z2 = { mins: w.z2, title: 'Z2 · ' + w.z2 + ' MIN', text: w.z2 + ' min at conversational pace. Run/walk is fine. If you cannot talk in full sentences, slow down.' };
  if (cardioType === 'run') return z2;
  if (cardioType === 'bike' || cardioType === 'row') return { ...z2, text: 'Z2 alternative: ' + w.z2 + ' min steady at conversational effort.' };
  if (cardioType === 'hiit') return { mins: w.hard.mins, title: 'HARD SESSION', text: w.hard.text + ' This is the only hard conditioning of the week.' };
  if (cardioType === 'bag') {
    const rounds = [4, 4, 5, 3, 4, 5, 6, 3, 5, 6, 6, 4][pos.week - 1];
    return { mins: rounds * 4, title: 'HARD SESSION · BAG', text: 'Heavy bag: ' + rounds + ' × 3 min rounds / 1 min rest. This replaces the hard session — it is the only hard conditioning of the week.' };
  }
  if (cardioType === 'bjj') return { mins: 60, title: 'BJJ', text: 'BJJ replaces this week\'s hard session — do one or the other, not both. Log mat time and rounds rolled.' };
  if (cardioType === 'ruck' || cardioType === 'trail') {
    return { mins: w.long.mins, title: 'LONG EFFORT · ' + w.long.mins + ' MIN', text: cardioType === w.long.type ? w.long.text : w.long.mins + ' min ' + (cardioType === 'ruck' ? 'ruck @ 35–45 lb' : 'on trail') + ', easy effort.' };
  }
  return null;
}

// Week 1 starting points for BASE (8–10 reps @ RPE 6). Estimated from the Aug 2025
// baseline less ~20% for time off. Week 1 logs replace these.
