<script>
window.addEventListener('error', function(e) {
  var d = document.getElementById('app');
  if (d) d.innerHTML = '<div style="padding:24px;color:#ff4444;font-family:monospace;font-size:13px;line-height:1.5;"><b style="font-size:16px;">Error:</b><br>' + (e.message || 'unknown') + '<br><br><span style="color:#888;font-size:11px;">' + (e.filename || '').split('/').pop() + ':' + (e.lineno || '') + ':' + (e.colno || '') + '</span></div>';
});
window.addEventListener('unhandledrejection', function(e) {
  // Do NOT blank a running app over a stray async rejection. Only show if the app never rendered.
  var d = document.getElementById('app');
  if (d && d.childElementCount === 0) {
    d.innerHTML = '<div style="padding:24px;color:#ff4444;font-family:monospace;font-size:13px;line-height:1.5;"><b>Async error:</b><br>' + ((e.reason && e.reason.message) || e.reason || 'unknown') + '</div>';
  } else {
    try { console.warn('Unhandled rejection (suppressed):', e.reason); } catch(_){}
  }
  if (e.preventDefault) e.preventDefault();
});
</script>
<script>




const {
  useState,
  useEffect,
  useMemo,
  useRef
} = React;
const el = React.createElement;

/* =========================================================
   DATA
   ========================================================= */

// Exercise library — name → { category, cues, yt, pfAlt }
const EX = {
  'Neck 4-Way': {
    cat: 'Neck & Grip',
    cues: ['Band or plate: flexion, extension, each side', 'Slow 2-sec reps — never jerk the neck', 'Start embarrassingly light; neck DOMS is brutal', 'Non-negotiable before BJJ at 45'],
