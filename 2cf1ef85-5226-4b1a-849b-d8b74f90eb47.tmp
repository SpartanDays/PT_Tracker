  // SQUAT / KNEE-DOMINANT
  'Back Squat': {
    cat: 'Squat / Knee-Dominant',
    cues: ['Brace like you\'re taking a punch — big belly breath before descent', 'Knees track over toes, weight stays on midfoot', 'Hip crease below knee crease for full depth'],
    pf: 'Smith machine squat or hack squat'
  },
  'Front Squat': {
    cat: 'Squat / Knee-Dominant',
    cues: ['Elbows up, fingertip grip on bar — bar sits on shoulder shelf', 'More upright torso than back squat — chest stays tall', 'Quad-dominant; ego-check the load coming back'],
    pf: 'Hack squat or goblet squat'
  },
  'Belt Squat': {
    cat: 'Squat / Knee-Dominant',
    cues: ['Stay upright, push hips down not back', 'Drive through whole foot', 'Easier on lower back — push intensity here when low back is fried'],
    pf: 'Hack squat or leg press'
  },
  'Walking Lunge': {
    cat: 'Squat / Knee-Dominant',
    cues: ['Long step out, knee tracks over front foot', 'Drive up through front heel/midfoot', 'Trail knee comes close to floor without crashing'],
    pf: 'DB walking lunge — same'
  },
  'Bulgarian Split Squat': {
    cat: 'Squat / Knee-Dominant',
    cues: ['Front foot far enough that front shin stays vertical at the bottom', 'Drive through front heel/midfoot only', 'Back leg is balance, not propulsion'],
    pf: 'Same — bench plus DBs'
  },
  'Leg Press': {
    cat: 'Squat / Knee-Dominant',
    cues: ['Feet shoulder-width, midfoot pressure', 'Don\'t lock knees at top — keep tension', 'Control the descent, no bouncing'],
    pf: 'Standard at PF'
  },
  'Single-Leg Leg Press': {
    cat: 'Squat / Knee-Dominant',
    cues: ['Same form as bilateral, lighter load', 'Drive through midfoot/heel', 'Match reps both sides — start with weak side'],
    pf: 'Standard at PF'
  },
  'Hack Squat': {
    cat: 'Squat / Knee-Dominant',
    cues: ['Like a back squat — brace, knees over toes, full depth', 'Easier to load heavy with less stabilization', 'Don\'t cut depth for weight'],
    pf: 'Common at PF'
  },
  'Smith Machine Squat': {
    cat: 'Squat / Knee-Dominant',
    cues: ['Stand with feet slightly forward of bar (not directly under)', 'Bar path is fixed — work with it, don\'t fight it', 'Brace and depth same as free squat'],
    pf: 'Default PF squat option'
  },
  'Leg Extension': {
    cat: 'Squat / Knee-Dominant',
    cues: ['3-second eccentric (slow down)', 'Squeeze quad hard at the top', 'Don\'t slam back to bottom — keep tension'],
    pf: 'Standard machine'
  },
  // HINGE / POSTERIOR CHAIN
  'Deadlift': {
    cat: 'Hinge / Posterior Chain',
    cues: ['Bar over midfoot before you bend down', 'Lats tight (think "protect armpits"), neutral spine, big breath in', 'Push the floor away — leg drive, not back lift'],
    pf: 'Trap bar if available; else Smith RDL + back extension'
  },
  'Romanian Deadlift': {
    cat: 'Hinge / Posterior Chain',
    cues: ['Soft knees but they don\'t bend more during the rep — pure hip hinge', 'Bar stays close — drag it down your thighs', 'Stop just below knee or where hamstrings pull tight; never round'],
    pf: 'DB RDL or Smith RDL'
  },
  'DB RDL': {
    cat: 'Hinge / Posterior Chain',
    cues: ['Same hip hinge — hips back, not down', 'DBs scrape down sides of legs', 'Slight arch, never round — stop where hamstrings pull tight'],
    pf: 'Same with DBs'
  },
  'KB Swing': {
    cat: 'Hinge / Posterior Chain',
    cues: ['Hinge, not a squat — hips go back, not down', 'Bell floats on hip momentum, you don\'t lift it with arms', 'Glutes finish hard at top, full standing tall'],
    pf: 'Use DB or skip'
  },
  'Trap Bar Deadlift': {
    cat: 'Hinge / Posterior Chain',
    cues: ['Easier on lower back — handles at sides', 'Stand tall at top, don\'t shrug', 'Same hinge: hips back, drive floor away'],
